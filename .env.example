# Copy this file to .env. Never commit real tokens.
FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
PORT=5000
META_GRAPH_VERSION=v26.0
# JSON map of Facebook Page ID -> Page access token. Keep this file private.
# Example: {"123456789012345":"EAAB..."}
FB_PAGE_TOKENS_JSON={}
# Optional custom DB path
# DATABASE_PATH=posting.db
